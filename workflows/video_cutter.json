{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "video_cutter.mp4"
    }
  },
  "2": {
    "class_type": "LFGG_VideoCutter",
    "inputs": {
      "video": ["1", 0],
      "selection_mode": "Frames",
      "start_time": 0.0,
      "end_time": -1.0,
      "first_frame": 3,
      "last_frame": 8
    }
  },
  "3": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["2", 0],
      "filename_prefix": "lfgg/video/cut",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
